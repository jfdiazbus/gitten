# Local files that should stay out of future commits
.env
*.secret
cache/
/root-only.txt
file with spaces
!public.secret

# Optional files not needed by install.sh's command-line build.
# These rules do not untrack existing source files.
/ci/
/git-gui/
/gitk-git/
/gitweb/
/po/
/Documentation/RelNotes/
/RelNotes
/.clang-format
/.editorconfig
/.tsan-suppressions
